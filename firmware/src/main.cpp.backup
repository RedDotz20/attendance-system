// =========================
// --- MQTT Callback ---
// =========================
void mqttCallback(char* topic, byte* payload, unsigned int length) {
  Serial.print("📨 Message arrived [");
  Serial.print(topic);
  Serial.print("] ");

  String message = "";
  for (unsigned int i = 0; i < length; i++) {
    message += (char)payload[i];
  }
  Serial.println(message);

  // Handle device control commands
  if (String(topic) == "attendance/device/control") {
    DynamicJsonDocument doc(1024);
    DeserializationError error = deserializeJson(doc, message);

    if (error) {
      Serial.print("❌ JSON parsing failed: ");
      Serial.println(error.c_str());
      return;
    }

    // Check if command is for this device
    String deviceId = "esp32_att_" + String((uint32_t)(ESP.getEfuseMac() & 0xFFFFFFFF), HEX);
    String targetDevice = doc["device_id"] | "";

    if (targetDevice != deviceId && targetDevice != "all") {
      Serial.println("⏭️  Command not for this device, ignoring");
      return;
    }

    String command = doc["command"] | "";

    if (command == "set_mode") {
      String mode = doc["mode"] | "";

      if (mode == "register") {
        registerMode = true;
        Serial.println("✅ Mode switched to REGISTER via MQTT");
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("Mode: Register");
        lcd.setCursor(0, 1);
        lcd.print("From Web UI");
        delay(1500);
        lcdShowMode();

        // Acknowledge mode change
        StaticJsonDocument<200> ackDoc;
        ackDoc["device_id"] = deviceId;
        ackDoc["status"] = "success";
        ackDoc["message"] = "Mode changed to register";
        ackDoc["current_mode"] = "register";
        String ackPayload;
        serializeJson(ackDoc, ackPayload);
        mqttClient.publish("attendance/device/response", ackPayload.c_str());

      } else if (mode == "attendance") {
        registerMode = false;
        clearRegistrationData();
        Serial.println("✅ Mode switched to ATTENDANCE via MQTT");
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("Mode: Attend");
        lcd.setCursor(0, 1);
        lcd.print("From Web UI");
        delay(1500);
        lcdShowMode();

        // Acknowledge mode change
        StaticJsonDocument<200> ackDoc;
        ackDoc["device_id"] = deviceId;
        ackDoc["status"] = "success";
        ackDoc["message"] = "Mode changed to attendance";
        ackDoc["current_mode"] = "attendance";
        String ackPayload;
        serializeJson(ackDoc, ackPayload);
        mqttClient.publish("attendance/device/response", ackPayload.c_str());
      }
    } else if (command == "get_status") {
      // Send device status
      StaticJsonDocument<300> statusDoc;
      statusDoc["device_id"] = deviceId;
      statusDoc["mode"] = registerMode ? "register" : "attendance";
      statusDoc["wifi_connected"] = (WiFi.status() == WL_CONNECTED);
      statusDoc["mqtt_connected"] = mqttClient.connected();
      statusDoc["sensor_ready"] = finger.verifyPassword();
      statusDoc["registration_pending"] = awaitingRegistrationDetails;
      if (awaitingRegistrationDetails) {
        statusDoc["pending_fp_id"] = pendingFingerprintID;
      }
      String statusPayload;
      serializeJson(statusDoc, statusPayload);
      mqttClient.publish("attendance/device/response", statusPayload.c_str());
      Serial.println("📤 Status sent via MQTT");
    } else if (command == "set_registration_data") {
      // Set name and department for pending registration
      String name = doc["name"] | "";
      String dept = doc["department"] | "";

      if (name.length() > 0 && dept.length() > 0) {
        nameInput = name;
        departmentInput = dept;
        Serial.println("✅ Registration data received via MQTT");
        Serial.println("Name: " + nameInput);
        Serial.println("Dept: " + departmentInput);

        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("Ready to Enroll");
        lcd.setCursor(0, 1);
        lcd.print(name.substring(0, 16));
        delay(2000);

        // Show clear enrollment prompt
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("Scan Finger Now");
        lcd.setCursor(0, 1);
        lcd.print("for " + name.substring(0, 11));

        // Acknowledge
        StaticJsonDocument<200> ackDoc;
        ackDoc["device_id"] = deviceId;
        ackDoc["status"] = "success";
        ackDoc["message"] = "Registration data set - ready for enrollment";
        String ackPayload;
        serializeJson(ackDoc, ackPayload);
        mqttClient.publish("attendance/device/response", ackPayload.c_str());
      }
    }
  }
}

// =========================
// --- MQTT Connect / Setup ---
// =========================
bool connectMQTT() {
  if (mqttClient.connected()) return true;

  // Ensure WiFi is connected first
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected - cannot connect MQTT");
    return false;
  }

  String clientId;
  if (String(MQTT_CLIENT_ID) != "") {
    clientId = String(MQTT_CLIENT_ID);
  } else {
    // generate from MAC
    uint64_t chipid = ESP.getEfuseMac();
    uint32_t shortId = (uint32_t)(chipid & 0xFFFFFFFF);
    clientId = "esp32_att_" + String(shortId, HEX);
  }

  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
  mqttClient.setCallback(mqttCallback);

  // First attempt: try with certificate validation
  #if USE_INSECURE
    Serial.println("MQTT: using insecure TLS (no cert validation)");
    secureClient.setInsecure();
  #else
    Serial.println("MQTT: attempting secure connection with CA cert");
    secureClient.setCACert(HIVE_CA);
  #endif

  Serial.printf("Attempting MQTT connection to %s:%d as %s ...\n", MQTT_SERVER, MQTT_PORT, clientId.c_str());

  bool ok = mqttClient.connect(clientId.c_str(), MQTT_USER, MQTT_PASS);

  // If secure connection failed and we're not already using insecure, try fallback
  #if !USE_INSECURE
  if (!ok) {
    int rc = mqttClient.state();
    Serial.printf("❌ Secure MQTT connection failed, rc=%d. Trying insecure fallback...\n", rc);

    // Try insecure connection as fallback
    secureClient.setInsecure();
    ok = mqttClient.connect(clientId.c_str(), MQTT_USER, MQTT_PASS);

    if (ok) {
      Serial.println("⚠️  MQTT connected using insecure TLS (no certificate validation)");
    }
  }
  #endif

  if (ok) {
    Serial.println("✅ MQTT connected successfully!");
    mqttConnected = true;

    // Publish retained status so backend knows device is online
    StaticJsonDocument<200> statusDoc;
    statusDoc["device_id"] = clientId;
    statusDoc["status"] = "online";
    statusDoc["timestamp"] = millis();
    String statusMsg;
    serializeJson(statusDoc, statusMsg);
    mqttClient.publish(MQTT_TOPIC_STATUS, statusMsg.c_str(), true); // retained
    return true;
  } else {
    int rc = mqttClient.state();
    Serial.printf("❌ MQTT connection failed completely, rc=%d\n", rc);
    mqttConnected = false;
    return false;
  }
}

void setupMQTT() {
  // note: setServer and callback are called inside connectMQTT as well;
  // call connect to attempt initial connection
  if (connectMQTT()) {
    // Subscribe to control topic after successful connection
    String deviceId = "esp32_att_" + String((uint32_t)(ESP.getEfuseMac() & 0xFFFFFFFF), HEX);
    mqttClient.subscribe("attendance/device/control", 1);
    Serial.println("✅ Subscribed to attendance/device/control");
  }
}

// =========================
// --- Publish Attendance ---
// =========================
void publishAttendanceEvent(uint16_t fingerprintID, const String& userName, const String& department) {
  if (!mqttClient.connected()) {
    unsigned long now = millis();
    if (now - lastMqttReconnectAttempt < MQTT_RECONNECT_DELAY) {
      Serial.println("MQTT not connected and reconnect delay not passed; abort publish");
      return;
    }
    lastMqttReconnectAttempt = now;
    if (!connectMQTT()) {
      Serial.println("MQTT publish aborted — failed to connect");
      return;
    }
  }

  StaticJsonDocument<300> doc;
  // device id: use configured client id or generated id
  String deviceId = (String(MQTT_CLIENT_ID) != "") ? String(MQTT_CLIENT_ID) : String("esp32_att_") + String((uint32_t)(ESP.getEfuseMac() & 0xFFFFFFFF), HEX);
  doc["device_id"] = deviceId;
  doc["fingerprint_id"] = String(fingerprintID);  // Convert to string for consistency with HTTP API
  doc["timestamp"] = millis(); // production: use NTP for actual time
  doc["event_type"] = "attendance";
  if (userName.length() > 0) doc["user_name"] = userName;
  if (department.length() > 0) doc["department"] = department;

  String payload;
  serializeJson(doc, payload);

  bool success = mqttClient.publish(MQTT_TOPIC_EVENTS, payload.c_str());
  if (success) {
    Serial.println("Attendance event published successfully");
    Serial.println("Payload: " + payload);
    // Feedback on LCD
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Event Sent!");
    lcd.setCursor(0, 1);
    lcd.print("ID: " + String(fingerprintID));
  } else {
    Serial.println("Failed to publish attendance event");
    lcdShowError("MQTT Failed");
  }
}

// =========================
// --- Setup / Loop ---
// =========================
void setup() {
  WiFi.mode(WIFI_STA);
  Serial.begin(115200);
  delay(1000);

  // LCD init
  lcd.init();
  lcd.backlight();
  lcdShowStartup();

  // Fingerprint sensor
  mySerial.begin(57600, SERIAL_8N1, RX_PIN, TX_PIN);
  finger.begin(57600);
  if (!finger.verifyPassword()) {
    Serial.println("❌ Fingerprint sensor not found.");
    lcdShowError("Sensor not found");
    while (true) { delay(1); } // halt
  }
  Serial.print("✅ Fingerprint sensor detected. Capacity: ");
  Serial.println(finger.capacity);

  // Connect WiFi (WiFiManager used for convenience/provisioning)
  lcdShowWiFiConnecting();
  wm.setConfigPortalTimeout(WIFI_TIMEOUT);
  // Attempt auto connect; if the SSID/PW are provided above it will use them,
  // otherwise it will spin up an AP for config.
  if (!wm.autoConnect(DEFAULT_AP_NAME.c_str())) {
    Serial.println("Failed to connect WiFi via WiFiManager.");
    lcdShowError("WiFi Failed");
    delay(2000);
    ESP.restart();
  }
  lcdShowWiFiConnected();
  Serial.println("Connected to WiFi!");
  Serial.print("Local IP: ");
  Serial.println(WiFi.localIP());

  // Setup MQTT (HiveMQ Cloud)
  Serial.println("Initializing MQTT connection...");
  setupMQTT();

  Serial.println("\n=== FINGERPRINT ATTENDANCE SYSTEM ===");
  delay(2000);
  lcdShowMode();
  printMenu();
}

void loop() {
  // handle MQTT reconnects
  if (!mqttClient.connected()) {
    unsigned long now = millis();
    if (now - lastMqttReconnectAttempt > MQTT_RECONNECT_DELAY) {
      lastMqttReconnectAttempt = now;
      connectMQTT();
    }
  } else {
    mqttClient.loop();
  }

  // Serial commands
  if (Serial.available()) {
    String input = Serial.readStringUntil('\n');
    input.trim();
    handleSerialCommand(input);
  }

  checkWiFiConnection();

  // Fingerprint debounce
  if (millis() - lastFingerprintRead < FINGERPRINT_READ_DELAY) {
    return;
  }

  // Check fingerprint
  uint16_t fingerprintID = verifyFingerprint();
  if (fingerprintID != 0) {
    lastFingerprintRead = millis();
    Serial.print("👆 Fingerprint ID: ");
    Serial.println(fingerprintID);
    lcdShowFingerprint(fingerprintID);
    delay(1500);

    if (registerMode) {
      // In register mode: register this fingerprint to server
      if (nameInput == "" || departmentInput == "") {
        Serial.println("⚠️  Enter name and department first.");
        Serial.println("Commands: name <your name>");
        Serial.println("          dept <your department>");
        lcdShowError("Need Name/Dept");
        indicateError();
        delay(2000);
        lcdShowMode();
      } else {
        Serial.println("📡 Registering existing fingerprint to server...");
        registerFingerprint(fingerprintID, nameInput, departmentInput);
      }
    } else {
      // In attendance mode: check if registered and mark attendance
      if (checkFingerprintRegistered(fingerprintID)) {
        markAttendance(fingerprintID);
      } else {
        Serial.println("⚠️  Fingerprint not registered.");
        Serial.println("💡 Tip: Use 'mode register' then 'name <name>' and 'dept <dept>' to register");
        lcdShowError("Not Registered");
        pendingFingerprintID = fingerprintID;
        awaitingRegistrationDetails = true;
        indicateError();
        delay(2000);
        lcdShowMode();
      }
    }
  } else {
    // No recognized fingerprint; in register mode with data set, auto-enroll the next finger
    if (registerMode && nameInput != "" && departmentInput != "" && !isAutoEnrolling) {
      isAutoEnrolling = true;
      Serial.println("8 Auto-enroll flow starting (name/dept already set). Place finger when prompted...");
      uint16_t newId = enrollNewFingerprint();

      if (newId > 0) {
        pendingFingerprintID = newId;
        awaitingRegistrationDetails = false;
        Serial.printf("7 Enrolled new ID: %d; registering with server...\n", newId);
        
        // Give sensor time to complete internal operations before registering
        Serial.println("Waiting for sensor to finalize enrollment...");
        delay(1000);
        registerFingerprint(newId, nameInput, departmentInput);
        Serial.println("0 Auto-enroll failed or timed out; will retry on next attempt.");
        lcdShowError("Enroll failed");
        delay(1500);
        lcdShowMode();
      }

      // small cooldown to avoid hammering enroll in tight loop
      lastFingerprintRead = millis();
      isAutoEnrolling = false;
    }
  }

  delay(50);
}

// =========================
// --- LCD helper functions ---
// (Kept your original messages)
void lcdShowStartup() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Fingerprint Sys");
  lcd.setCursor(0, 1);
  lcd.print("Booting...");
}
void lcdShowWiFiConnecting() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("CONNECTING WiFi");
  lcd.setCursor(0, 1);
  lcd.print("-Please Wait-");
}
void lcdShowWiFiConnected() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("WiFi Connected!");
}
void lcdShowMode() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Mode:");
  lcd.setCursor(6, 0);
  if (registerMode) {
    lcd.print("Register");
  } else {
    lcd.print("Attendance");
  }
}
void lcdShowScanPrompt() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Place Finger...");
}
void lcdShowFingerprint(uint16_t id) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("FP ID: ");
  lcd.print(id);
  lcd.setCursor(0, 1);
  lcd.print("Verifying...");
}
void lcdShowAttendanceSuccess() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Attendance");
  lcd.setCursor(0, 1);
  lcd.print("Marked!");
}
void lcdShowRegistrationSuccess() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Registration");
  lcd.setCursor(0, 1);
  lcd.print("Complete!");
}
void lcdShowError(String msg) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Error!");
  lcd.setCursor(0, 1);
  lcd.print(msg);
}

// =========================
// --- Serial command handling ---
// =========================
void printMenu() {
  Serial.println("\n=== FINGERPRINT ATTENDANCE SYSTEM ===");
  Serial.println("COMMANDS:");
  Serial.println("mode register    - Switch to registration mode");
  Serial.println("mode attendance  - Switch to attendance mode");
  Serial.println("enroll           - Enroll new fingerprint to sensor");
  Serial.println("name <full name> - Set name for registration");
  Serial.println("dept <dept>      - Set department for registration");
  Serial.println("clear            - Clear registration data");
  Serial.println("menu             - Show this menu");
  Serial.println("\nREGISTRATION WORKFLOW:");
  Serial.println("1. 'mode register' - switch to register mode");
  Serial.println("2. 'name John Doe' - set the name");
  Serial.println("3. 'dept Engineering' - set department");
  Serial.println("4a. Scan existing fingerprint to register it OR");
  Serial.println("4b. 'enroll' to add new fingerprint then scan it");
  Serial.println("==========================================\n");
}

void handleSerialCommand(String cmd) {
  if (cmd.equalsIgnoreCase("mode register")) {
    registerMode = true;
    Serial.println("✅ Switched to REGISTER mode.");
    lcdShowMode();
  } else if (cmd.equalsIgnoreCase("mode attendance")) {
    registerMode = false;
    Serial.println("✅ Switched to ATTENDANCE mode.");
    lcdShowMode();
  } else if (cmd.equalsIgnoreCase("enroll")) {
    Serial.println("📝 Starting fingerprint enrollment...");
    uint16_t newID = enrollNewFingerprint();
    if (newID > 0) {
      Serial.printf("✅ Fingerprint enrolled with ID: %d\n", newID);
      Serial.println("Please set name and department to complete registration:");
      Serial.println("   name <your name>");
      Serial.println("   dept <your department>");
      pendingFingerprintID = newID;
      awaitingRegistrationDetails = true;
    }
  } else if (cmd.startsWith("name ")) {
    nameInput = cmd.substring(5);
    nameInput.trim();
    Serial.printf("👤 Name set to: %s\n", nameInput.c_str());
    if (awaitingRegistrationDetails && departmentInput != "" && pendingFingerprintID > 0) {
      registerFingerprint(pendingFingerprintID, nameInput, departmentInput);
      awaitingRegistrationDetails = false;
      pendingFingerprintID = 0;
    }
  } else if (cmd.startsWith("dept ")) {
    departmentInput = cmd.substring(5);
    departmentInput.trim();
    Serial.printf("🏢 Department set to: %s\n", departmentInput.c_str());
    if (awaitingRegistrationDetails && nameInput != "" && pendingFingerprintID > 0) {
      registerFingerprint(pendingFingerprintID, nameInput, departmentInput);
      awaitingRegistrationDetails = false;
      pendingFingerprintID = 0;
    }
  } else if (cmd.startsWith("apikey ")) {
    String newApiKey = cmd.substring(7);
    newApiKey.trim();
    if (newApiKey.length() > 0) {
      apiKey = newApiKey.c_str();
      Serial.printf("🔑 API key updated to: %s\n", newApiKey.c_str());
      Serial.println("⚠️  Note: API key will reset to default on restart");
    } else {
      Serial.println("❌ Please provide an API key: apikey <your_key>");
    }
  } else if (cmd.equalsIgnoreCase("clear")) {
    clearRegistrationData();
    Serial.println("🧹 Registration data cleared.");
  } else if (cmd.equalsIgnoreCase("menu")) {
    printMenu();
  } else {
    Serial.println("❌ Unknown command. Type 'menu' for available commands.");
  }
}

// =========================
// --- Fingerprint routines ---
// =========================
uint16_t enrollNewFingerprint() {
  Serial.println("\n=== FINGERPRINT ENROLLMENT ===");

  // Find next available ID
  uint16_t id = 1;
  for (uint16_t i = 1; i <= finger.capacity; i++) {
    if (finger.loadModel(i) != FINGERPRINT_OK) {
      id = i;
      break;
    }
  }

  if (id > finger.capacity) {
    Serial.println("❌ Sensor memory full!");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Memory Full!");
    delay(2000);
    return 0;
  }

  Serial.printf("Enrolling fingerprint at ID #%d\n", id);
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Enroll ID: " + String(id));
  lcd.setCursor(0, 1);
  lcd.print("Place Finger...");

  // === FIRST IMAGE ===
  int p = -1;
  int attempts = 0;
  const int MAX_ATTEMPTS = 50; // 5 seconds timeout

  Serial.println("Waiting for finger placement...");
  while ((p = finger.getImage()) != FINGERPRINT_OK) {
    delay(100);
    attempts++;
    if (attempts > MAX_ATTEMPTS) {
      Serial.println("❌ Timeout waiting for finger");
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Timeout!");
      delay(2000);
      return 0;
    }
  }

  Serial.println("✅ First image captured");
  lcd.setCursor(0, 1);
  lcd.print("Processing...  ");

  if (finger.image2Tz(1) != FINGERPRINT_OK) {
    Serial.println("❌ Failed to convert first image");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Image Error!");
    lcd.setCursor(0, 1);
    lcd.print("Try Again");
    delay(2000);
    return 0;
  }

  Serial.println("✅ First template created");
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Remove Finger");
  lcd.setCursor(0, 1);
  lcd.print("Wait...");
  delay(2000);

  // Wait for finger to be removed
  while (finger.getImage() != FINGERPRINT_NOFINGER) {
    delay(100);
  }

  Serial.println("✅ Finger removed");

  // === SECOND IMAGE ===
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Place SAME");
  lcd.setCursor(0, 1);
  lcd.print("Finger Again...");

  Serial.println("Waiting for same finger placement...");
  attempts = 0;
  while ((p = finger.getImage()) != FINGERPRINT_OK) {
    delay(100);
    attempts++;
    if (attempts > MAX_ATTEMPTS) {
      Serial.println("❌ Timeout waiting for second scan");
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Timeout!");
      delay(2000);
      return 0;
    }
  }

  Serial.println("✅ Second image captured");
  lcd.setCursor(0, 1);
  lcd.print("Processing...  ");

  if (finger.image2Tz(2) != FINGERPRINT_OK) {
    Serial.println("❌ Failed to convert second image");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Image Error!");
    lcd.setCursor(0, 1);
    lcd.print("Try Again");
    delay(2000);
    return 0;
  }

  Serial.println("✅ Second template created");
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Matching...");

  // === CREATE MODEL ===
  p = finger.createModel();
  if (p == FINGERPRINT_OK) {
    Serial.println("✅ Fingerprints matched successfully");
  } else if (p == FINGERPRINT_ENROLLMISMATCH) {
    Serial.println("❌ Fingerprints did not match - please try again");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("No Match!");
    lcd.setCursor(0, 1);
    lcd.print("Try Again");
    delay(2000);
    return 0;
  } else {
    Serial.printf("❌ Error creating model: code=%d\n", p);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Model Error!");
    delay(2000);
    return 0;
  }

  // === STORE MODEL ===
  lcd.setCursor(0, 1);
  lcd.print("Saving...      ");

  p = finger.storeModel(id);
  if (p == FINGERPRINT_OK) {
    Serial.printf("✅ Fingerprint enrolled successfully at ID #%d\n", id);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Enrolled!");
    lcd.setCursor(0, 1);
    lcd.print("ID: " + String(id));
    delay(2000);
    
    // Wait for sensor to complete internal flash operations
    Serial.println("Waiting for sensor to finalize storage...");
    delay(500);
    
    return id;
  } else {
    Serial.printf("❌ Error storing fingerprint: code=%d\n", p);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Save Error!");
    lcd.setCursor(0, 1);
    lcd.print("Code: " + String(p));
    delay(2000);
    return 0;
  }
}

uint16_t verifyFingerprint() {
  // Improved fingerprint verification with multiple attempts and better feedback
  const int MAX_RETRIES = 3;
  const int RETRY_DELAY = 200; // ms between retries
  static bool showedWaitingMessage = false;

  for (int attempt = 1; attempt <= MAX_RETRIES; attempt++) {
    // Step 1: Capture image with retry logic
    int p = finger.getImage();

    if (p == FINGERPRINT_NOFINGER) {
      if (attempt == 1 && !showedWaitingMessage) {
        Serial.println("No finger detected");
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("Place Finger");
        lcd.setCursor(0, 1);
        lcd.print("On Scanner...");
        showedWaitingMessage = true;
      }
      // Return 0 immediately on first attempt if no finger - don't retry
      return 0;
    }

    // Finger detected, clear the waiting message flag
    showedWaitingMessage = false;

    if (p != FINGERPRINT_OK) {
      Serial.printf("Image capture failed (attempt %d/%d): code=%d\n", attempt, MAX_RETRIES, p);
      if (p == FINGERPRINT_IMAGEFAIL) {
        Serial.println("Imaging error - finger may be too dry or sensor dirty");
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("Image Error!");
        lcd.setCursor(0, 1);
        lcd.print("Try Again");
      }
      delay(RETRY_DELAY);
      continue;
    }

    Serial.println("Image captured, processing...");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Processing...");

    // Step 2: Convert image to template
    p = finger.image2Tz();
    if (p != FINGERPRINT_OK) {
      Serial.printf("Template conversion failed (attempt %d/%d): code=%d\n", attempt, MAX_RETRIES, p);
      if (p == FINGERPRINT_IMAGEMESS) {
        Serial.println("Image too messy - press finger firmly");
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("Too Messy!");
        lcd.setCursor(0, 1);
        lcd.print("Press Firmly");
      } else if (p == FINGERPRINT_FEATUREFAIL) {
        Serial.println("Could not find fingerprint features");
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("No Features!");
        lcd.setCursor(0, 1);
        lcd.print("Retry");
      }
      delay(RETRY_DELAY * 2);
      continue;
    }

    Serial.println("Template created, searching database...");
    lcd.setCursor(0, 1);
    lcd.print("Searching...   ");

    // Step 3: Search fingerprint database
    p = finger.fingerFastSearch();

    if (p == FINGERPRINT_OK) {
      Serial.printf("✅ Fingerprint matched! ID=%d, Confidence=%d\n", finger.fingerID, finger.confidence);
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Match Found!");
      lcd.setCursor(0, 1);
      lcd.print("ID: " + String(finger.fingerID));
      delay(500); // Brief success display
      return finger.fingerID;
    } else if (p == FINGERPRINT_NOTFOUND) {
      Serial.println("❌ No match found in database");
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("No Match!");
      lcd.setCursor(0, 1);
      lcd.print("Not Registered");
      delay(1500);
      return 0;
    } else {
      Serial.printf("Search error (attempt %d/%d): code=%d\n", attempt, MAX_RETRIES, p);
      delay(RETRY_DELAY);
    }
  }

  // All retries exhausted (only happens if finger was detected but processing failed)
  Serial.println("❌ Verification failed after all retries");
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Scan Failed!");
  lcd.setCursor(0, 1);
  lcd.print("Try Again");
  delay(1500);
  showedWaitingMessage = false; // Reset for next scan
  return 0;
}

// =========================
// --- HTTP helpers & actions ---
// =========================
void setupHTTPClient(HTTPClient &http, String url) {
  http.begin(url);
  http.setTimeout(HTTP_TIMEOUT);
  http.setConnectTimeout(HTTP_CONNECT_TIMEOUT);
}

bool checkFingerprintRegistered(uint16_t fingerprintID) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi not connected!");
    indicateError();
    return false;
  }
  HTTPClient http;
  setupHTTPClient(http, baseUrl + checkEndpoint + String(fingerprintID));
  http.addHeader("X-API-Key", apiKey);
  int httpResponseCode = http.GET();
  bool isRegistered = false;
  if (httpResponseCode == 200) {
    String payload = http.getString();
    isRegistered = (payload.indexOf("\"registered\":true") != -1) || (payload.indexOf("true") != -1);
    if (isRegistered) Serial.println("✅ Fingerprint is registered");
    else Serial.println("❌ Fingerprint not found in database");
  } else if (httpResponseCode == 404) {
    Serial.println("❌ Fingerprint not found in database");
  } else {
    Serial.printf("❌ HTTP Error: %d\n", httpResponseCode);
    if (httpResponseCode > 0) Serial.println("Response: " + http.getString());
    indicateError();
  }
  http.end();
  return isRegistered;
}

void registerFingerprint(uint16_t fingerprintID, String name, String department) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi not connected!");
    lcdShowError("No WiFi");
    indicateError();
    return;
  }

  HTTPClient http;
  String fullUrl = baseUrl + registerEndpoint;
  Serial.println("📤 Registering fingerprint...");
  Serial.println("URL: " + fullUrl);
  Serial.println("FP ID: " + String(fingerprintID));
  Serial.println("Name: " + name);
  Serial.println("Dept: " + department);

  setupHTTPClient(http, fullUrl);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-API-Key", apiKey);

  String jsonPayload = "{\"fingerprintId\":\"" + String(fingerprintID) + "\",\"name\":\"" + name + "\",\"department\":\"" + department + "\"}";
  Serial.println("JSON: " + jsonPayload);

  int httpResponseCode = http.POST(jsonPayload);
  Serial.println("HTTP Response Code: " + String(httpResponseCode));

  if (httpResponseCode == 200 || httpResponseCode == 201) {
    Serial.printf("✅ Registration successful! (HTTP %d)\n", httpResponseCode);
    String response = http.getString();
    if (response.length() > 0) Serial.println("Server response: " + response);
    lcdShowRegistrationSuccess();
    delay(3000);
    lcdShowMode();
    clearRegistrationData();
  } else if (httpResponseCode > 0) {
    Serial.printf("⚠️  Registration failed: HTTP %d\n", httpResponseCode);
    String response = http.getString();
    if (response.length() > 0) Serial.println("Server response: " + response);
    lcdShowError("HTTP " + String(httpResponseCode));
    delay(3000);
    lcdShowMode();
  } else {
    Serial.printf("❌ Network error: %s\n", http.errorToString(httpResponseCode).c_str());
    lcdShowError("Network Error");
    delay(3000);
    lcdShowMode();
  }
  http.end();
}

void markAttendance(uint16_t fingerprintID) {
  if (WiFi.status() != WL_CONNECTED) { Serial.println("❌ WiFi not connected!"); indicateError(); return; }
  Serial.println("📡 Publishing MQTT attendance event...");
  publishAttendanceEvent(fingerprintID);
  HTTPClient http;
  setupHTTPClient(http, baseUrl + attendanceEndpoint);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-API-Key", apiKey);
  String jsonPayload = "{\"fingerprintId\":\"" + String(fingerprintID) + "\"}";
  Serial.println("📝 Marking attendance...");
  int httpResponseCode = http.POST(jsonPayload);
  if (httpResponseCode == 200 || httpResponseCode == 201) {
    Serial.printf("✅ Attendance marked! (HTTP %d)\n", httpResponseCode);
    String response = http.getString(); if (response.length() > 0) Serial.println("Server response: " + response);
    lcdShowAttendanceSuccess(); delay(2000); lcdShowMode();
  } else if (httpResponseCode > 0) {
    Serial.printf("⚠️  Attendance response: HTTP %d\n", httpResponseCode);
    String response = http.getString(); if (response.length() > 0) Serial.println("Server response: " + response);
    lcdShowError("Att Failed"); delay(2000); lcdShowMode();
  } else {
    Serial.printf("❌ Network error: %s\n", http.errorToString(httpResponseCode).c_str());
    lcdShowError("Network Error"); delay(2000); lcdShowMode();
  }
  http.end();
}

// =========================
// --- Misc helpers ---
// =========================
void clearRegistrationData() {
  nameInput = "";
  departmentInput = "";
  pendingFingerprintID = 0;
  awaitingRegistrationDetails = false;
}

void indicateError() {
  Serial.println("⚠️  Error occurred!");
}

void checkWiFiConnection() {
  static unsigned long lastCheck = 0;
  const unsigned long CHECK_INTERVAL = 30000;
  if (millis() - lastCheck < CHECK_INTERVAL) return;
  lastCheck = millis();
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("📡 WiFi disconnected. Attempting to reconnect...");
    WiFi.begin();
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 20) {
      delay(500);
      Serial.print(".");
      attempts++;
    }
    if (WiFi.status() == WL_CONNECTED) {
      Serial.println("\n✅ WiFi reconnected!");
    } else {
      Serial.println("\n❌ Failed to reconnect. Starting config portal...");
      wm.startConfigPortal(DEFAULT_AP_NAME.c_str());
    }
  }
}
