VITE_API_URL=http://localhost:3000
VITE_API_SECRET_KEY=your_secure_api_secret_key_here
# HiveMQ Cloud WebSocket URL (replace with your cluster URL)
# Format: wss://your-cluster-url.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_WS_URL=wss://your-cluster-url.s1.eu.hivemq.cloud:8883/mqtt
VITE_MQTT_USERNAME=your_hivemq_username
VITE_MQTT_PASSWORD=your_hivemq_password
